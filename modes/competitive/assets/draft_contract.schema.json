{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/draft_contract.schema.json",
  "title": "Competitive Draft Contract",
  "type": "object",
  "required": ["stable_id", "version", "domain_id", "competition", "ruleset", "participants", "eligible_pool", "phases", "terminal_states", "lineup_constraints", "tests"],
  "properties": {
    "stable_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "domain_id": {"const": "competitive_rules"},
    "competition": {"type": "object"},
    "ruleset": {"type": "object"},
    "participants": {"type": "array", "minItems": 2},
    "eligible_pool": {"type": "array", "minItems": 1},
    "phases": {"type": "array", "minItems": 1},
    "terminal_states": {"type": "array", "minItems": 1},
    "lineup_constraints": {"type": "object"},
    "tests": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
