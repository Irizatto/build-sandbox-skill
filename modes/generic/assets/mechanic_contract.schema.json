{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/mechanic_contract.schema.json",
  "title": "Persistent Sandbox Mechanic Contract",
  "type": "object",
  "required": ["stable_id", "version", "domain_id", "state_schema", "initial_state", "participants", "phases", "actions", "invariants", "terminal_conditions", "visibility", "tests"],
