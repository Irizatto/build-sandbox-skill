    "domain_id": {"type": "string", "minLength": 1},
    "state_schema": {"type": "object"},
    "initial_state": {"type": "object"},
    "participants": {"type": "array", "minItems": 1},
    "phases": {"type": "array", "minItems": 1},
    "actions": {"type": "array", "minItems": 1},
    "resolution_priority": {"type": "array"},
    "randomness": {"type": "object"},
    "counters": {"type": "array"},
    "invariants": {"type": "array", "minItems": 1},
    "terminal_conditions": {"type": "array", "minItems": 1},
    "visibility": {"type": "object"},
    "tests": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
